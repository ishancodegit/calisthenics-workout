# Trading Agent Configuration
# Copy this to .env and fill in your values

# Trading API Credentials (get from your broker)
TRADING_API_KEY=your_api_key_here
TRADING_API_SECRET=your_api_secret_here

# Server Configuration
PORT=3000
LOG_PATH=/opt/trading-agent/logs/trading-agent.log

# Trading Mode
# Set to 'false' for LIVE trading (DANGER! Test extensively first)
PAPER_TRADING=true

# Risk Management Settings
# Maximum daily loss before stopping trading
MAX_DAILY_LOSS_PERCENT=2

# Maximum position size as percentage of portfolio
MAX_POSITION_SIZE_PERCENT=5

# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=5

# Minimum stop-loss percentage to enforce
MIN_STOP_LOSS_PERCENT=1.5

# Maximum leverage multiplier (1 = no leverage)
MAX_LEVERAGE=1

# Enable/Disable Features
ENABLE_AUTO_STOP_LOSS=true
ENABLE_RISK_MANAGEMENT=true

# Optional: Comma-separated list of allowed trading symbols
# Leave empty to allow all
# ALLOWED_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Node.js
NODE_ENV=production
