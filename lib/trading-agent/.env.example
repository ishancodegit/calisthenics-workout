# Copy to .env and fill in. Never commit the filled-in file.

# --- Alpaca credentials -----------------------------------------------------
# Generate at https://app.alpaca.markets/paper/dashboard/overview (Paper keys).
# Paper and live accounts have SEPARATE keys. Paper keys cannot touch real money.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Trading mode -----------------------------------------------------------
# true  -> https://paper-api.alpaca.markets (simulated money)
# false -> https://api.alpaca.markets (REAL money)
PAPER_TRADING=true

# Going live requires this to be set to exactly I_UNDERSTAND_THE_RISK *in
# addition* to PAPER_TRADING=false. Two independent signals, so one stray edit
# cannot point the agent at real money.
# CONFIRM_LIVE_TRADING=

# --- What to trade ----------------------------------------------------------
SYMBOLS=AAPL,MSFT,GOOGL

# --- Risk limits ------------------------------------------------------------
# Stop opening positions once the day is down this % of equity.
MAX_DAILY_LOSS_PERCENT=2

# Cap any single position at this % of equity.
MAX_POSITION_SIZE_PERCENT=5

# Never hold more than this many positions at once.
MAX_OPEN_POSITIONS=5

# Stop-loss distance from entry, submitted to the broker as a bracket order.
MIN_STOP_LOSS_PERCENT=2

# Ignore signals weaker than this (0-1).
MIN_CONFIDENCE=0.5

MAX_LEVERAGE=1

# --- Runtime ----------------------------------------------------------------
LOG_PATH=./logs/trading-agent.log
