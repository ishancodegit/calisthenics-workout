rules_version = '2';

// Simple rules for playing with friends: anyone with a room code can read
// and write that game. Good enough for a private friends app, not for
// a public App Store release.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read, write: if true;
      match /players/{playerId} {
        allow read, write: if true;
      }
    }
  }
}
